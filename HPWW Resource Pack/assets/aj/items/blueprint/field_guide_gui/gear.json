{
	"model": {
		"type": "minecraft:select",
		"property": "minecraft:custom_model_data",
		"cases": [
			{
				"when": "AJ_INTERNAL_EMPTY",
				"model": {
					"type": "minecraft:empty"
				}
			},
			{
				"when": "gear_normal",
				"model": {
					"type": "minecraft:model",
					"model": "aj:blueprint/field_guide_gui/gear_normal/gear",
