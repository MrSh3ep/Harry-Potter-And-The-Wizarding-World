						{"type": "minecraft:dye", "default": [1, 1, 1]}
					]
				}
			},
			{
				"when": "gear_higlighted",
				"model": {
					"type": "minecraft:model",
					"model": "aj:blueprint/field_guide_gui/gear_higlighted/gear",
					"tints": [
						{"type": "minecraft:dye", "default": [1, 1, 1]}
					]
				}
			}
		],
		"fallback": {
			"type": "minecraft:model",
			"model": "aj:blueprint/field_guide_gui/gear",
			"tints": [
				{"type": "minecraft:dye", "default": [1, 1, 1]}
			]
		}
	}
}